# Copy this file to server/.env and fill in the values. Never commit server/.env.

# Neon PostgreSQL connection string, e.g.
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# The direct endpoint (no "-pooler" in the host) is enough for this app. The pooled one works too,
# but some home/ISP DNS resolvers refuse "-pooler" hostnames.
DATABASE_URL=

# Optional: a separate Neon branch for automated tests. If empty, tests use DATABASE_URL
# and only create/delete their own throwaway users (emails ending in @advs.test).
TEST_DATABASE_URL=

# Long random string used to sign login tokens, e.g. the output of:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

API_PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

# Password given to every demo user created by `npm run seed` (local development only)
SEED_PASSWORD=Advs@Demo2026
